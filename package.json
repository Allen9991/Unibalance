{
  "name": "unibalance-demo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.23.5 <23",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:phone": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test \"src/**/*.test.js\" \"server/**/*.test.js\"",
    "lint": "eslint src server scripts *.js --max-warnings=0",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "agent:context": "node scripts/agent-context.mjs",
    "release:artifact": "node scripts/create-release.mjs",
    "cap:sync": "vite build && cap sync",
    "cap:sync:ios:phone": "vite build --mode phone && cap sync ios",
    "cap:copy": "vite build && cap copy",
    "cap:open:ios": "cap open ios",
    "cap:doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "7.3.8"
  }
}
